{
  "name": "blitzprompts",
  "private": true,
  "version": "1.0.0",
  "description": "A local-only Chrome extension for managing and inserting reusable prompts.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Cp557/blitzprompts.git"
  },
  "bugs": {
    "url": "https://github.com/Cp557/blitzprompts/issues"
  },
  "homepage": "https://github.com/Cp557/blitzprompts#readme",
  "engines": {
    "node": "^20.0.0 || >=22.0.0"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && vite build --config vite.content.config.ts",
    "build:main": "vite build",
    "build:content": "vite build --config vite.content.config.ts",
    "lint": "eslint .",
    "preview": "vite preview"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@hugeicons/core-free-icons": "^4.2.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/chrome": "^0.0.287",
    "@types/node": "^22.10.3",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.16",
    "globals": "^15.14.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.6.2",
    "typescript-eslint": "^8.18.2",
    "vite": "^6.0.5"
  }
